const int buzzerPin = 8;

void setup() {
  pinMode(buzzerPin, OUTPUT);
}

void loop() {
  digitalWrite(buzzerPin, HIGH);  // buzzer ON
  delay(200);                     // beep for 200 ms
  digitalWrite(buzzerPin, LOW);   // buzzer OFF
  delay(500);                     // silence for 500 ms
}

If you have a passive buzzer (it needs a tone signal rather than plain on/off), use this instead:

cpp
const int buzzerPin = 8;

void setup() {
  pinMode(buzzerPin, OUTPUT);
}

void loop() {
  tone(buzzerPin, 1000);   // 1000 Hz tone
  delay(200);
  noTone(buzzerPin);
  delay(500);
}
